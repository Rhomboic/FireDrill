# Which scenario + policy to run (used by runner/run_job.py)
SCENARIO=01-payments-service-down
MODEL=claude-opus-4-8

# Override the upstream API id for a registry entry if it differs from the key,
# e.g. if gpt-5.5 maps to a dated snapshot. Optional.
# MODEL_API_ID=

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Episode controls
MAX_STEPS=30

# AWS (only needed for S3 upload of results)
AWS_DEFAULT_REGION=us-west-1
S3_BUCKET=
S3_KEY_PREFIX=runs/
